# ==============================================================================
# SeshHub Core Server Configuration
# ==============================================================================
APP_ENV=development
PORT=53053
BASE_URL=http://localhost:53053
SUBOTTO_INSTANCE=subotto.seshsofa.nl

# ==============================================================================
# Database (libSQL / Turso)
# ==============================================================================
# For local file: "file:seshhub.db"
# For in-memory: ":memory:"
# For Turso Cloud: "libsql://[your-db].turso.io?authToken=[your-token]"
DATABASE_URL=file:seshhub.db
DATABASE_AUTH_TOKEN=

# ==============================================================================
# Discord OAuth2 & Guild RBAC
# ==============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_HUB_ADMIN_ROLE_ID=
DISCORD_HOSTS_ROLE_ID=
DISCORD_SKATER_ROLE_ID=
SUPERADMIN_DISCORD_IDS=

# ==============================================================================
# YouTube OAuth2 (login + link a channel)
# ==============================================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Google Analytics 4 measurement ID (omit to skip the tag)
GTAG_ID=
