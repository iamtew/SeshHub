# ==============================================================================
# SeshHub Core Server Configuration
# ==============================================================================
APP_ENV=development
PORT=53053
BASE_URL=http://localhost:53053
SUBOTTO_INSTANCE=subotto.seshsofa.nl

# ==============================================================================
# Database (libSQL / Turso)
# ==============================================================================
# For local file: "file:seshhub.db"
# For in-memory: ":memory:"
# For Turso Cloud: "libsql://[your-db].turso.io?authToken=[your-token]"
DATABASE_URL=file:seshhub.db
DATABASE_AUTH_TOKEN=

# ==============================================================================
# Discord OAuth2 & Guild RBAC
# ==============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# users.role rank (highest Discord match wins): hub admin / superadmin IDs → skater → friends.
# Hosts is users.host (Spot/Episodes), not a rank — can combine with any role above.
SUPERADMIN_DISCORD_IDS=
DISCORD_HUB_ADMIN_ROLE_ID=
DISCORD_SKATER_ROLE_ID=
DISCORD_FRIENDS_ROLE_ID=
DISCORD_HOSTS_ROLE_ID=
# Bot token from the same application (Bot → Token), not the OAuth client secret.
# Empty = no gateway. Invite the bot with Send Messages. Manage it at /admin/bot.
DISCORD_BOT_TOKEN=

# ==============================================================================
# YouTube OAuth2 (login + link a channel)
# ==============================================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ==============================================================================
# YouTube Data API (public stats poller — not OAuth)
# ==============================================================================
# Console: APIs & Services → Credentials → Create credentials → API key.
# Restrict the key to YouTube Data API v3 (and the VPS IP in production).
YOUTUBE_DATA_API_KEY=

# Google Analytics 4 measurement ID (omit to skip the tag)
GTAG_ID=
